#!/usr/bin/env bash

sfg_universal_remote_control__configure_desktop_shortcut() {
    local SCRIPT_DIR
    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>"/dev/null" && pwd)"
    source "${SCRIPT_DIR}/../../.devcontainer/scripts/bash_utils/common"

    local START_TEXT="> Configuring desktop shortcut."
    local END_TEXT="< Done configuring desktop shortcut."

    sfg_bash_utils__print_info "${START_TEXT}"

    if [[ ! -t 0 ]]; then
        sfg_bash_utils__print_plain "No terminal available for input. Skipping desktop shortcut creation."
        sfg_bash_utils__print_info "${END_TEXT}"
        return 0
    fi

    local desktop_dir
    desktop_dir=$(xdg-user-dir DESKTOP 2>"/dev/null" || echo "${HOME}/Desktop")
    local desktop_filepath="${desktop_dir}/universal_remote_control.desktop"

    # Check if the desktop entry already exists.
    if [[ -f "${desktop_filepath}" ]]; then
        local MESSAGE="A desktop shortcut already exists. Do you want to remove it? [y/N] "
        read -rp "${MESSAGE}" confirm

        if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
            sfg_bash_utils__print_info "${END_TEXT}"
            return 0
        fi

        sfg_bash_utils__print_plain "Removing desktop shortcut..."
        rm -f "${desktop_filepath}"
    else
        local MESSAGE="No desktop shortcut found. Do you want to create one? [y/N] "
        read -rp "${MESSAGE}" confirm

        if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
            sfg_bash_utils__print_info "${END_TEXT}"
            return 0
        fi

        sfg_bash_utils__print_plain "Creating desktop shortcut..."
        local DESKTOP_TEMPLATE="${SCRIPT_DIR}/../config/universal_remote_control.desktop.template"
        local CMD="${SCRIPT_DIR}/launch_universal_remote_control"
        local ICON_FILEPATH="${SCRIPT_DIR}/../assets/icon.svg"

        # shellcheck disable=SC2016
        CMD="${CMD}" ICON_FILEPATH="${ICON_FILEPATH}" envsubst '${CMD} ${ICON_FILEPATH}' <"${DESKTOP_TEMPLATE}" >"${desktop_filepath}"
        chmod +x "${desktop_filepath}"

        if command -v gio &>"/dev/null"; then
            gio set "${desktop_filepath}" metadata::trusted true 2>"/dev/null" || true
        fi
    fi

    sfg_bash_utils__print_info "${END_TEXT}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    set -e
    sfg_universal_remote_control__configure_desktop_shortcut "${@}"
fi
